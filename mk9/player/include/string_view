#pragma once
#include <cstddef>
namespace std {
class string_view {
 public:
  constexpr string_view(const char* text, size_t size) noexcept : text_(text), size_(size) {}
  constexpr const char* data() const noexcept { return text_; }
  constexpr size_t size() const noexcept { return size_; }

 private:
  const char* text_;
  size_t size_;
};
}  // namespace std
