diff --git a/src/core/filesystem_win.cpp b/src/core/filesystem_win.cpp
index c5a2c5d..854cb82 100644
--- a/src/core/filesystem_win.cpp
+++ b/src/core/filesystem_win.cpp
@@ -122,21 +122,32 @@ class Win32FileHandle : public FileHandle {
   bool Read(size_t file_offset, void* buffer, size_t buffer_length,
             size_t* out_bytes_read) override {
     *out_bytes_read = 0;
-    OVERLAPPED overlapped;
-    overlapped.Pointer = (PVOID)file_offset;
-    overlapped.hEvent = NULL;
-    DWORD bytes_read = 0;
-    BOOL read = ReadFile(handle_, buffer, (DWORD)buffer_length, &bytes_read, &overlapped);
-    if (read) {
-      *out_bytes_read = bytes_read;
-      return true;
-    } else {
-      if (GetLastError() == ERROR_NOACCESS) {
-        REXLOG_WARN(
-            "Win32FileHandle::Read(..., {}, 0x{:X}, ...) returned "
-            "ERROR_NOACCESS. Read-only memory?",
-            buffer, buffer_length);
+    for (int attempt = 0;; attempt++) {
+      OVERLAPPED overlapped{};
+      overlapped.Pointer = (PVOID)file_offset;
+      overlapped.hEvent = NULL;
+      DWORD bytes_read = 0;
+      BOOL read = ReadFile(handle_, buffer, (DWORD)buffer_length, &bytes_read, &overlapped);
+      if (read) {
+        *out_bytes_read = bytes_read;
+        return true;
+      }
+      if (GetLastError() != ERROR_NOACCESS) return false;
+      // mk9-rollback: guest pages a write watcher keeps read-only (the game's rollback): the
+      // kernel fails ReadFile into them instead of faulting, so each page takes a user-mode write
+      // first (the watcher lets it through) and the read goes again
+      if (attempt < 8) {
+        const uintptr_t begin = reinterpret_cast<uintptr_t>(buffer);
+        for (uintptr_t a = begin; a < begin + buffer_length; a = (a | 0xFFF) + 1) {
+          volatile uint8_t* b = reinterpret_cast<volatile uint8_t*>(a);
+          *b = *b;
+        }
+        continue;
       }
+      REXLOG_WARN(
+          "Win32FileHandle::Read(..., {}, 0x{:X}, ...) returned "
+          "ERROR_NOACCESS. Read-only memory?",
+          buffer, buffer_length);
       return false;
     }
   }
