diff --git a/src/system/function_dispatcher.cpp b/src/system/function_dispatcher.cpp
index bd43109..4886e48 100644
--- a/src/system/function_dispatcher.cpp
+++ b/src/system/function_dispatcher.cpp
@@ -13,6 +13,9 @@
  *              role as a function dispatch table rather than a CPU emulator.
  */
 
+#include <cstring>
+#include <string>
+
 #include <rex/assert.h>
 #include <rex/dbg.h>
 #include <rex/logging.h>
@@ -34,7 +37,29 @@ FunctionDispatcher* GetBoundFunctionDispatcher() {
 
 }  // namespace
 
-static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
+static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* base) {
+  // mk9-rollback: where the call came from (the return address set for it), and the guest stack's
+  // return addresses above it (back chain at 0(r1), each caller's saved LR at -8 of the frame above)
+  std::string chain;
+  if (base) {
+    // only inside the thread's stack: its PCR (r13) has the bounds, +0x70 high, +0x74 low
+    auto word = [&](uint32_t a) {
+      uint32_t v = 0;
+      std::memcpy(&v, base + a, 4);
+      return __builtin_bswap32(v);
+    };
+    const uint32_t pcr = ctx.r13.u32;
+    const uint32_t hi = pcr ? word(pcr + 0x70) : 0, lo = pcr ? word(pcr + 0x74) : 0;
+    uint32_t sp = ctx.r1.u32;
+    for (int i = 0; i < 12 && hi > lo && sp >= lo && sp + 4 <= hi; i++) {
+      const uint32_t back = word(sp);
+      if (back <= sp || back > hi || back - 8 < lo) break;
+      chain += fmt::format(" {:08X}", word(back - 8));
+      sp = back;
+    }
+  }
+  REXCPU_ERROR("invalid call: lr {:08X} r1 {:08X} r3 {:08X} r11 {:08X} r12 {:08X}, stack{}",
+               uint32_t(ctx.lr), ctx.r1.u32, ctx.r3.u32, ctx.r11.u32, ctx.r12.u32, chain);
   REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
             ctx.last_indirect_target);
 }
