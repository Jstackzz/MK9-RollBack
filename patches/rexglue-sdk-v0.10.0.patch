+// The guest writes no commands meanwhile (see IGraphicsSystem::SkipDrawsFromNow), so the write index
+// now is where its last frame ends: the worker has not passed it, and stops there to switch.
+void CommandProcessor::SkipDrawsFromNow(bool skip) {
+  uint32_t write_ptr_index = write_ptr_index_.load();
+  if (write_ptr_index == 0xBAADF00D) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(skip_marks_mutex_);
+  skip_marks_.emplace_back(write_ptr_index, skip);
+  skip_marks_waiting_ = true;
+}
+
+uint32_t CommandProcessor::SkipMarkedEnd(uint32_t write_ptr_index) {
+  if (!skip_marks_waiting_) {
+    return write_ptr_index;
+  }
+  std::lock_guard<std::mutex> lock(skip_marks_mutex_);
+  while (!skip_marks_.empty() && skip_marks_.front().first == read_ptr_index_) {
+    SetSkippingDraws(skip_marks_.front().second);
+    skip_marks_.pop_front();
+  }
+  skip_marks_waiting_ = !skip_marks_.empty();
+  if (skip_marks_.empty()) {
+    return write_ptr_index;
+  }
+  // how far ahead of the read index the mark and the write index are, around the ring
+  uint32_t ring_dwords = primary_buffer_size_ / sizeof(uint32_t);
+  uint32_t mark = skip_marks_.front().first;
+  uint32_t to_mark = (mark + ring_dwords - read_ptr_index_) % ring_dwords;
+  uint32_t to_write = (write_ptr_index + ring_dwords - read_ptr_index_) % ring_dwords;
+  return to_mark < to_write ? mark : write_ptr_index;
+}
+
+void CommandProcessor::SetSkippingDraws(bool skip) {
+  if (skip == skipping_draws_) {
+    return;
+  }
+  skipping_draws_ = skip;
+  if (skip) {
+    ++skipped_.runs;
+    return;
+  }
+  auto now = std::chrono::steady_clock::now();
+  if (now - skipped_logged_ < std::chrono::seconds(10)) {
+    return;
+  }
+  REXGPU_INFO(
+      "Frames nobody sees, {} runs of them: {} swaps, {} draws and {} resolves skipped, {} "
+      "vertical blanks given at once; {} draws done (targets up to {}x{})",
+      skipped_.runs, skipped_.swaps, skipped_.draws, skipped_.resolves, skipped_.vblanks,
+      skipped_.kept, skipped_.kept_width, skipped_.kept_height);
+  skipped_logged_ = now;
+  skipped_ = {};
+}
